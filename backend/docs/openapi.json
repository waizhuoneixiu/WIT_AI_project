  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "title": "AnalysisRequest"
      },
      "Base64Request": {
        "properties": {
          "image_base64": {
            "type": "string",
            "title": "Image Base64"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "default": "base64_image.jpg"
          },
          "conf": {
            "type": "number",
            "title": "Conf"
          },
          "imgsz": {
            "type": "integer",
            "title": "Imgsz"
          }
        },
        "type": "object",
        "required": [
          "image_base64"
        ],
        "title": "Base64Request"
      },
      "Body_create_inspection_api_inspections_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image"
          },
          "batch_no": {
            "type": "string",
            "title": "Batch No"
          },
          "workpiece_no": {
            "type": "string",
            "title": "Workpiece No"
          }
        },
        "type": "object",
        "required": [
          "image",
          "batch_no"
        ],
        "title": "Body_create_inspection_api_inspections_post"
      },
      "Body_detect_batch_detect_batch_post": {
        "properties": {
          "images": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Images"
          }
        },
        "type": "object",
        "required": [
