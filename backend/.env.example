# 复制为 .env 后使用；不要提交到 Git
# ---------- 后端安全 ----------
# 设置后 /detect* 与 /model/info、/api* 需要请求头 X-API-Key；留空则不鉴权（仅本机/内网）
STEELSCAN_API_KEY=

# ---------- DeepSeek 大模型（质检分析/追问） ----------
# 在 https://platform.deepseek.com/ 创建 API Key 后填入；留空则自动使用离线规则模板
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
# 超时（秒）/ 重试次数
LLM_TIMEOUT=40
LLM_MAX_RETRIES=2

# 本地大模型（无 Key 离线方案；先运行 scripts/download_local_llm.py）
# auto: 有 DEEPSEEK_API_KEY 用云 API，否则本地模型存在则用本地，否则规则模板
LLM_PROVIDER=auto
LOCAL_LLM_MODEL=
LOCAL_LLM_DEVICE=cuda
LOCAL_LLM_MAX_NEW_TOKENS=2000

# ---------- 服务 ----------
# 本地启动端口（deploy/run_server.sh 使用）
PORT=8000
